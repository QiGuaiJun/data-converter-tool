# ⚠️ 安全提示（2026-10-08 补）：
#   HOST=0.0.0.0 是给 Railway 这类 PaaS 用的（它们要求监听所有网卡才能路由进来）。
#   但 0.0.0.0 + APP_AUTH_ENABLED=false = 【没有任何认证，且监听所有网卡】——
#   等于把工具连同「能执行任意 SQL 的查询控制台」暴露给整个局域网，
#   而控制台里通常挂着生产库连接。因此：
#     · 桌面/本机使用：保持 HOST=127.0.0.1（启动导表工具.bat 已经写死，不要改）
#     · 需要局域网访问：必须同时把 APP_AUTH_ENABLED=true 并设好 ADMIN_PASSWORD
#     · 云端：HOST=127.0.0.1 + nginx 反代（见 docs/腾讯云部署准备-20260922.md）
#   绝不要为了"图方便"把 HOST 改成 0.0.0.0 同时关着认证。
HOST=0.0.0.0
PORT=8765
APP_AUTH_ENABLED=false
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
# Railway: create one Volume and mount it to /data.
# Relative DATA_DIR/UPLOADS_DIR/EXPORTS_DIR will be stored inside RAILWAY_VOLUME_MOUNT_PATH.
DATA_DIR=./data
UPLOADS_DIR=./uploads
EXPORTS_DIR=./exports
APP_TIMEZONE=Asia/Shanghai
